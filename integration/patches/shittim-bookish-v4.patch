-    recovery.maxAttempts === 3 &&
-    isSafeInteger(recovery.used) &&
-    recovery.limit === 3 &&
-    recovery.attempt >= 1 &&
-    recovery.attempt <= recovery.maxAttempts &&
-    recovery.used >= 0 &&
-    recovery.used <= recovery.limit
-  ) {
-    progress.recovery = {
-      reason: "model_output_invalid",
