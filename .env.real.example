# Copy to .env.real.local. The local file is ignored by Git.
# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
BETTER_AUTH_TRUSTED_PROXIES=127.0.0.1/32

# Real Resend server credential and a sender on a verified domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Real Zhihu Open Platform Access Secret.
ZHIHU_ACCESS_SECRET=
ZHIHU_MODEL=zhida-thinking-1p5
ZHIHU_SOURCE_TIMEOUT_MS=30000
ZHIHU_MODEL_TIMEOUT_MS=60000
REAL_API_VERIFY_TOPIC="TypeScript 泛型约束"

GENERATION_WORKER_ID=generation-worker-real-local-1
GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600
GENERATION_RATE_LIMIT_MAX_REQUESTS=5

# Optional loopback port overrides.
ZHIJING_REAL_WEB_PORT=3001
ZHIJING_REAL_DATABASE_PORT=55433
