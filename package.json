{
  "name": "zhijing",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \".github/workflows/*.{yml,yaml}\" \"*.{json,ts,mjs,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \".github/workflows/*.{yml,yaml}\" \"*.{json,ts,mjs,yml,yaml}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "architecture": "tsx scripts/check-architecture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project architecture",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration --no-file-parallelism --maxWorkers=1",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test": "pnpm test:unit && pnpm test:architecture && pnpm test:contracts && pnpm test:integration && pnpm test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.6"
  }
}
