{
  "name": "zhijing",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "docker compose -f compose.demo.yaml up --build",
    "demo:down": "docker compose -f compose.demo.yaml down",
    "demo:prepare": "NODE_OPTIONS=--conditions=react-server tsx scripts/demo/prepare.ts",
    "real": "docker compose --env-file .env.real.local -f compose.real.yaml up --build",
    "real:down": "docker compose --env-file .env.real.local -f compose.real.yaml down",
    "real:verify:zhihu": "docker compose --env-file .env.real.local -f compose.real.yaml run --build --rm --no-deps generation-worker pnpm verify:zhihu",
    "worker:generation": "NODE_OPTIONS=--conditions=react-server tsx src/workers/generation-worker.ts",
    "verify:zhihu": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-real-zhihu.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \".github/workflows/*.{yml,yaml}\" \"*.{json,ts,mjs,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \".github/workflows/*.{yml,yaml}\" \"*.{json,ts,mjs,yml,yaml}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "architecture": "tsx scripts/check-architecture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project architecture",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration --no-file-parallelism --maxWorkers=1",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "test": "pnpm test:unit && pnpm test:architecture && pnpm test:contracts && pnpm test:integration && pnpm test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "1.3.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "antd": "6.6.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "lxgw-wenkai-screen-web": "^1.522.0",
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "three": "^0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.6"
  }
}
