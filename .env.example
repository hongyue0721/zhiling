# PostgreSQL used by the application and Drizzle migrations.
DATABASE_URL=postgresql://zhijing:zhijing-local@127.0.0.1:5432/zhijing

# Dedicated disposable database used only by integration tests.
TEST_DATABASE_URL=postgresql://zhijing:zhijing-local-test@127.0.0.1:5433/zhijing_test

# Generate with `openssl rand -base64 32`; never reuse this example value.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Replace with the exact reverse-proxy IPs/CIDRs in deployed environments.
BETTER_AUTH_TRUSTED_PROXIES=127.0.0.1

# Server-only Resend HTTP API credentials.
RESEND_API_KEY=re_replace_with_a_real_server_key
AUTH_EMAIL_FROM="知径 <auth@example.com>"
# Server-only Zhihu Open Platform credential. Never expose it to clients,
# databases, logs, fixtures, or error responses.
ZHIHU_ACCESS_SECRET=replace-with-a-real-server-access-secret

# Frozen first-phase structured model; only this documented model is accepted.
ZHIHU_MODEL=zhida-thinking-1p5

# Project request policies in milliseconds, not a provider SLA.
ZHIHU_SOURCE_TIMEOUT_MS=15000
ZHIHU_MODEL_TIMEOUT_MS=30000

# Stable per-process lease owner. Use a distinct value for every Worker replica.
GENERATION_WORKER_ID=generation-worker-local-1
